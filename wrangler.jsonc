{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glass-tasks",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "glass-task-db", "database_id": "48bc5268-36b9-419f-932e-bdfa5cdf03db"}],
  "ai": {"binding": "AI"}
}
